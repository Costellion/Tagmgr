<Page
    x:Class="Tagmgr.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tagmgr"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- 顶部标题 -->
        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Text="所有文件"
            FontSize="20"
            FontWeight="SemiBold"
            Margin="16,12"/>

        <!-- 左侧：文件列表 -->
        <ListView
    x:Name="FileListView"
    Grid.Row="1"
    Grid.Column="0"
    Margin="16,0,8,16"
    SelectionMode="Extended"
    ItemsSource="{x:Bind FileItems}">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FileTagItem">
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 文件图标 -->
                        <Image
                    Grid.Column="0"
                    Source="{x:Bind Icon, Mode=OneWay}"
                    Width="24"
                    Height="24"
                    Margin="0,2,10,0"
                    VerticalAlignment="Top"/>

                        <!-- 文件信息 + 标签 -->
                        <StackPanel Grid.Column="1">
                            <TextBlock
                        Text="{x:Bind FileName}"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"/>

                            <TextBlock
                        Text="{x:Bind FilePath}"
                        Foreground="Gray"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"/>

                            <ItemsControl
                        ItemsSource="{x:Bind Tags}"
                        Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="#E5E5E5"
                                            CornerRadius="6"
                                            Margin="0,0,6,0"
                                        Padding="8,2,4,2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"/>
                                                <Button
                                                    Content="&#xE711;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="10"
                                                    Width="18"
                                                    Height="18"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Tag="{Binding}"
                                                Click="RemoveTagChip_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 右侧：操作区 -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="8,0,16,16"
            Spacing="10">

            <Button
                Content="选择文件..."
                HorizontalAlignment="Stretch"
                Click="PickFile_Click"/>

            <TextBox
                x:Name="TagInput"
                PlaceholderText="输入想要添加/移除的标签，例如：工作"/>

            <Button
                Content="给选中文件添加标签"
                HorizontalAlignment="Stretch"
                Click="AddTag_Click"/>

            <Button
                Content="从选中文件移除标签"
                HorizontalAlignment="Stretch"
                Click="RemoveTag_Click"/>

            <Button
                Content="删除选中文件记录"
                HorizontalAlignment="Stretch"
                Click="DeleteFile_Click"/>

            <TextBlock
                Text="提示：先在左侧选中一个文件，再添加或移除标签。"
                TextWrapping="Wrap"
                Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Page>