<Page
    x:Class="Tagmgr.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tagmgr"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Padding="32"
            Spacing="16"
            MaxWidth="640"
            HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Spacing="16">
                <Image Width="256" Source="ms-appx:///Assets/Tagmgr.png" />
                <TextBlock
                    Text="Tagmgr"
                    FontSize="32"
                    FontWeight="Bold"
                    VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock
                Text="Build 0.1.1(20260925+3) by Costellion"
                Foreground="Gray"/>

            <TextBlock
                Text="一个轻量的文件标签管理工具，用于给本地文件打标签并按标签快速筛选。"
                TextWrapping="Wrap"/>

            <TextBlock
                Text="主要功能"
                FontSize="18"
                FontWeight="SemiBold"
                Margin="0,8,0,0"/>

            <StackPanel Spacing="6">
                <TextBlock Text="• 给任意本地文件添加多个标签，搜索文件/给文件排序"/>
                <TextBlock Text="• 支持多选文件，一键批量添加/移除标签"/>
                <TextBlock Text="• 可以重命名、合并标签，为标签修改颜色"/>
                <TextBlock Text="• 按多个标签交集筛选文件"/>
                <TextBlock Text="• 操作可以撤销/重做"/>
                <TextBlock Text="• 标签数据保存在本地，不上传任何信息"/>
            </StackPanel>

            <TextBlock
                Text="技术说明"
                FontSize="18"
                FontWeight="SemiBold"
                Margin="0,8,0,0"/>

            <StackPanel Spacing="6">
                <TextBlock Text="• WinUI 3 (Windows App SDK)"/>
                <TextBlock Text="• .NET / C#"/>
                <TextBlock Text="• Sqlite 本地虚拟化路径存储"/>
            </StackPanel>

            <TextBlock
                Text="数据保存名称：Tagmgr.db"
                Foreground="Gray"
                FontSize="12"
                Margin="0,16,0,0"
                TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</Page>