<Page
    x:Class="Tagmgr.TagsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tagmgr"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch"/>
        <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="OnSelectAll"/>
        <KeyboardAccelerator Key="Enter" Invoked="OnEnterKey"/>
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndo"/>
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedo"/>
    </Page.KeyboardAccelerators>
    <Grid x:Name="RootGrid" Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：所有标签 -->
        <StackPanel Grid.Column="0" Padding="16,12">
            <TextBlock
                Text="所有标签"
                FontSize="20"
                FontWeight="SemiBold"
                Margin="0,0,0,12"/>

            <ListView
                x:Name="TagListView"
                SelectionMode="Multiple"
                SelectionChanged="TagListView_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE8EC;"
                                FontSize="14"
                                Foreground="#666"/>
                            <TextBlock Text="{x:Bind}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- 右侧：过滤后的文件 -->
        <Grid Grid.Column="1" Padding="8,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="0"
                    PlaceholderText="在结果中搜索文件名、路径或标签..."
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged"/>
                <ComboBox
                    x:Name="SortComboBox"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    MinWidth="170"
                    SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="名称 A-Z" Tag="NameAsc"/>
                    <ComboBoxItem Content="名称 Z-A" Tag="NameDesc"/>
                    <ComboBoxItem Content="修改时间（新→旧）" Tag="ModifiedDesc"/>
                    <ComboBoxItem Content="修改时间（旧→新）" Tag="ModifiedAsc"/>
                </ComboBox>
            </Grid>
            <TextBlock
                x:Name="EmptyHint"
                Grid.Row="1"
                Text="请从左侧选择一个标签，查看相关文件"
                Foreground="Gray"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            <ListView
                x:Name="FilteredFileListView"
                Grid.Row="1"
                Visibility="Collapsed"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FileTagItem">
                        <Grid Margin="0,6"
                            DoubleTapped="FileItem_DoubleTapped"
                            RightTapped="FileItem_RightTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{x:Bind Icon, Mode=OneWay}" Width="24" Height="24" Margin="0,2,10,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock
                Text="{x:Bind FileName}"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis"/>

                                <TextBlock
                Text="{x:Bind FilePath}"
                Foreground="Gray"
                FontSize="12"
                TextTrimming="CharacterEllipsis"/>

                                <ItemsControl
                ItemsSource="{x:Bind Tags}"
                Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="{Binding Converter={StaticResource TagColorConverter}}"
                                                CornerRadius="6"
                                                Margin="0,0,6,0"
                                                Padding="8,2">
                                                <TextBlock Text="{Binding}" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>