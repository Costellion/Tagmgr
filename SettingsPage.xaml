<Page
    x:Class="Tagmgr.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tagmgr"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel
            Padding="32"
            Spacing="16"
            MaxWidth="720"
            HorizontalAlignment="Left">

            <TextBlock
                Text="设置"
                FontSize="24"
                FontWeight="SemiBold"/>

            <!-- 外观主题 -->
            <TextBlock
                Text="外观主题"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,8,0,0"/>

            <ComboBox
                x:Name="ThemeComboBox"
                MinWidth="220"
                SelectionChanged="Theme_SelectionChanged">
                <ComboBoxItem Content="跟随系统" Tag="Default"/>
                <ComboBoxItem Content="浅色" Tag="Light"/>
                <ComboBoxItem Content="深色" Tag="Dark"/>
            </ComboBox>

            <!-- 数据存储 -->
            <TextBlock
                Text="数据备份"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,16,0,0"/>

            <TextBlock
                Text="可通过下方按钮导出为备份文件，或从备份文件恢复。"
                Foreground="Gray"
                TextWrapping="Wrap"/>

            <TextBlock
                Text="数据存储于虚拟化路径。"
                Foreground="Gray"
                TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="导出数据..." Click="ExportData_Click"/>
                <Button Content="导入数据..." Click="ImportData_Click"/>
                <Button Content="打开数据文件夹" Click="OpenDataFolder_Click"/>
            </StackPanel>
            <TextBlock
                Text="维护"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,16,0,0"/>

            <TextBlock
                Text="检查所有文件记录对应的文件是否仍然存在。失效的文件可能已被移动、重命名或删除。"
                Foreground="Gray"
                TextWrapping="Wrap"/>

            <Button
                x:Name="CheckFilesButton"
                Content="检查文件状态..."
                Click="CheckFiles_Click"
                HorizontalAlignment="Left"/>

            <!-- 统计 -->
            <TextBlock
                Text="当前数据"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,16,0,0"/>

            <StackPanel Spacing="6">
                <TextBlock x:Name="FileCountText"/>
                <TextBlock x:Name="TagCountText"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>