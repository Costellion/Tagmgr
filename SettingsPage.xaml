<Page
    x:Class="Tagmgr.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tagmgr"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer>
        <StackPanel
            Padding="32"
            Spacing="16"
            MaxWidth="720"
            HorizontalAlignment="Left">

            <TextBlock
                x:Uid="SettingsPageTitle"
                FontSize="24"
                FontWeight="SemiBold"/>

            <!-- 外观主题 -->
            <TextBlock
                x:Uid="SettingsTheme"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,8,0,0"/>

            <ComboBox
                x:Name="ThemeComboBox"
                MinWidth="220"
                SelectionChanged="Theme_SelectionChanged">
                <ComboBoxItem x:Uid="SettingsThemeSystem" Tag="Default"/>
                <ComboBoxItem x:Uid="SettingsThemeLight" Tag="Light"/>
                <ComboBoxItem x:Uid="SettingsThemeDark" Tag="Dark"/>
            </ComboBox>
            <!-- 数据存储 -->
            <TextBlock
                x:Uid="SettingsBackup"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,16,0,0"/>

            <TextBlock
                x:Uid="SettingsBackupTip1"
                Foreground="Gray"
                TextWrapping="Wrap"/>

            <TextBlock
                x:Uid="SettingsBackupTip2"
                Foreground="Gray"
                TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Uid="SettingsExportData" Click="ExportData_Click"/>
                <Button x:Uid="SettingsImportData" Click="ImportData_Click"/>
                <!--<Button x:Uid="SettingsBackupDataFolder" Click="OpenDataFolder_Click"/>-->
            </StackPanel>
            <!-- 语言 -->
            <TextBlock
                x:Uid="SettingsLanguage"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,16,0,0"/>

            <TextBlock
                x:Uid="SettingsLanguageTip"
                Foreground="Gray"
                TextWrapping="Wrap"/>

            <ComboBox
                x:Name="LanguageComboBox"
                MinWidth="220"
                SelectionChanged="Language_SelectionChanged">
                <ComboBoxItem Content="跟随系统" Tag="System"/>
                <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                <ComboBoxItem Content="English" Tag="en-US"/>
            </ComboBox>
            <!-- 数据维护 -->
            <TextBlock
                x:Uid="SettingsMaintenance"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,16,0,0"/>

            <TextBlock
                x:Uid="SettingsMaintenanceTip"
                Foreground="Gray"
                TextWrapping="Wrap"/>

            <Button
                x:Name="CheckFilesButton"
                x:Uid="SettingsMaintenanceCheck"
                Click="CheckFiles_Click"
                HorizontalAlignment="Left"/>

            <!-- 统计 -->
            <TextBlock
                x:Uid="SettingsStatistics"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,16,0,0"/>

            <StackPanel Spacing="6">
                <TextBlock x:Name="FileCountText"/>
                <TextBlock x:Name="TagCountText"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>