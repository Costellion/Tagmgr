<Page
    x:Class="Tagmgr.TagManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tagmgr"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch"/>
        <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="OnSelectAll"/>
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteKey"/>
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndo"/>
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedo"/>
    </Page.KeyboardAccelerators>
    <Grid x:Name="RootGrid" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock
            Grid.Row="0"
            Text="标签管理"
            FontSize="20"
            FontWeight="SemiBold"
            Margin="0,0,0,12"/>

        <!-- 搜索 -->
        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="1"
            Margin="0,0,0,12"
            PlaceholderText="搜索标签..."
            QueryIcon="Find"
            TextChanged="SearchBox_TextChanged"/>

        <!-- 标签列表 -->
        <ListView
            x:Name="TagListView"
            Grid.Row="2"
            SelectionMode="Extended">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TagInfo">
                    <Grid Margin="0,6" ColumnSpacing="8" RightTapped="TagItem_RightTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 颜色块：点击可改颜色 -->
                        <Button
                            Grid.Column="0"
                            Width="28"
                            Height="28"
                            Padding="0"
                            CornerRadius="4"
                            Background="{x:Bind BackgroundBrush, Mode=OneWay}"
                            BorderThickness="1"
                            BorderBrush="#40000000"
                            Tag="{x:Bind Name}"
                            Click="ChangeColor_Click"
                            ToolTipService.ToolTip="设置颜色"/>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE8EC;"
                                FontSize="14"
                                Foreground="#666"/>
                            <TextBlock
                                Text="{x:Bind Name}"
                                FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind CountText}"
                            Foreground="Gray"
                            VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部操作区 -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Spacing="10"
            Margin="0,12,0,0">
            <Button Content="重命名" Click="Rename_Click"/>
            <Button Content="删除" Click="Delete_Click"/>
            <Button Content="合并..." Click="Merge_Click"/>
        </StackPanel>
    </Grid>
</Page>